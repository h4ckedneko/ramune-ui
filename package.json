{
  "name": "ramune-ui",
  "version": "0.0.0",
  "private": true,
  "packageManager": "pnpm@11.17.0",
  "scripts": {
    "build": "pnpm -r -F @ramune-ui/* build",
    "check": "dprint check && pnpm -r --if-present check",
    "format": "dprint fmt && pnpm -r --if-present format",
    "prepare": "lefthook install"
  },
  "devDependencies": {
    "dprint": "^0.55.2",
    "lefthook": "^2.1.10",
    "typescript": "^7.0.2"
  }
}
