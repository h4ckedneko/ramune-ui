{
  "name": "ramune-ui",
  "version": "0.0.0",
  "private": true,
  "scripts": {
    "build": "pnpm -r -F @ramune-ui/* build",
    "check": "dprint check && pnpm -r --if-present check",
    "format": "dprint fmt && pnpm -r --if-present format",
    "prepare": "lefthook install"
  },
  "devDependencies": {
    "dprint": "^0.61.1",
    "lefthook": "^2.2.1",
    "typescript": "^7.0.2"
  },
  "devEngines": {
    "packageManager": {
      "name": "pnpm",
      "version": ">=11",
      "onFail": "download"
    }
  }
}
